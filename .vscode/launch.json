{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "RZGit (this repo)",
			"type": "debugpy",
			"request": "launch",
			"module": "rzgit",
			"args": ["${workspaceFolder}"],
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "RZGit (choose repo…)",
			"type": "debugpy",
			"request": "launch",
			"module": "rzgit",
			"args": ["${input:repoPath}"],
			"console": "integratedTerminal",
			"justMyCode": true
		},
		{
			"name": "Current test file",
			"type": "debugpy",
			"request": "launch",
			"module": "unittest",
			"args": ["-v", "${relativeFile}"],
			"console": "integratedTerminal",
			"justMyCode": false
		}
	],
	"inputs": [
		{
			"id": "repoPath",
			"type": "promptString",
			"description": "Path to a git repository",
			"default": "${userHome}"
		}
	]
}
